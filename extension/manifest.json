{
  "manifest_version": 3,
  "name": "TabCatch Bridge",
  "version": "0.3.0",
  "description": "Sends the list of open tabs, and on request the cookies of a video page, to the TabCatch desktop app running on this computer.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "cookies",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "120",
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "TabCatch'e gönder"
  }
}
